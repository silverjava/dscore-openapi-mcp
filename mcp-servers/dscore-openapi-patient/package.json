{
  "name": "dscore-openapi-patient-mcp",
  "version": "1.0.1",
  "description": "MCP server providing patient search and retrieval tools for DS Core Open API with AI LLM integration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "dscore-openapi-patient": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node scripts/add-shebang.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "clean": "rimraf dist",
    "test": "jest"
  },
  "keywords": [
    "mcp",
    "patient",
    "healthcare",
    "dscore",
    "openapi",
    "ai",
    "llm"
